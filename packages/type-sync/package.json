{
  "name": "@farm-framework/type-sync",
  "version": "0.1.0",
  "description": "Type synchronization utility for FARM framework (standalone)",
  "main": "dist/index.js",
  "types": "dist/ts/index.d.ts",
  "type": "module",
  "bin": {
    "type-sync": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:ts": "tsc --build",
    "build:bundle": "tsup",
    "build:watch": "tsup --watch",
    "clean": "pnpm dlx rimraf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "vitest run __tests__/e2e.type-sync.spec.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "@farm-framework/types": "workspace:*",
    "change-case": "^5.4.4",
    "fs-extra": "^11.3.0",
    "lodash-es": "^4.17.21",
    "openapi-types": "^12.1.3",
    "zod": "^3.22.4",
    "commander": "^11.0.0",
    "inquirer": "^9.0.0",
    "chalk": "^5.0.0",
    "ora": "^7.0.0",
    "chokidar": "^3.6.0",
    "handlebars": "^4.7.8",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.8",
    "@types/change-case": "^2.3.5",
    "@types/chokidar": "2.1.7",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/inquirer": "^9.0.0",
    "@types/handlebars": "^4.1.0",
    "@types/prettier": "^3.0.0",
    "@types/vscode": "^1.74.0",
    "@types/node": "^20.0.0",
    "@types/eslint": "^8.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^23.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.3",
    "concurrently": "^8.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}