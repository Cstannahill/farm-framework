@echo off
REM Auto-generated setup script for {{project_name}}
REM Generated by FARM Framework CLI

setlocal enabledelayedexpansion

echo 🚀 Setting up {{project_name}}...

REM Check if we're in the right directory
if not exist "package.json" (
    echo ❌ package.json not found. Please run this script from the project root directory.
    pause
    exit /b 1
)

REM Check prerequisites
echo 🚀 Checking prerequisites...

REM Check Node.js
node --version >nul 2>&1
if errorlevel 1 (
    echo ❌ Node.js is not installed. Please install Node.js 18+ and try again.
    pause
    exit /b 1
)

REM Check Python
python --version >nul 2>&1
if errorlevel 1 (
    echo ❌ Python is not installed. Please install Python 3.11+ and try again.
    pause
    exit /b 1
)

echo ✅ Prerequisites check passed

REM Create Python virtual environment
echo 🚀 Creating Python virtual environment...
if exist "venv" (
    echo ⚠️ Virtual environment already exists. Removing old one...
    rmdir /s /q venv
)

python -m venv venv
if errorlevel 1 (
    echo ❌ Failed to create virtual environment
    pause
    exit /b 1
)
echo ✅ Virtual environment created

REM Activate venv and install Python dependencies
echo 🚀 Installing Python dependencies...
call venv\Scripts\activate.bat

REM Upgrade pip first
venv\Scripts\python.exe -m pip install --upgrade pip

REM Install requirements
if exist "apps\api\requirements.txt" (
    venv\Scripts\python.exe -m pip install -r apps\api\requirements.txt
    if errorlevel 1 (
        echo ❌ Failed to install Python dependencies
        pause
        exit /b 1
    )
    echo ✅ Python dependencies installed
) else (
    echo ⚠️ apps\api\requirements.txt not found, skipping Python dependencies
)

REM Deactivate venv
call venv\Scripts\deactivate.bat

REM Check for package manager
echo 🚀 Checking package manager...
pnpm --version >nul 2>&1
if not errorlevel 1 (
    set PACKAGE_MANAGER=pnpm
    echo ✅ Using pnpm
) else (
    yarn --version >nul 2>&1
    if not errorlevel 1 (
        set PACKAGE_MANAGER=yarn
        echo ✅ Using yarn
    ) else (
        set PACKAGE_MANAGER=npm
        echo ✅ Using npm
    )
)

REM Install Node.js dependencies
echo 🚀 Installing Node.js dependencies...
%PACKAGE_MANAGER% install
if errorlevel 1 (
    echo ❌ Failed to install Node.js dependencies
    pause
    exit /b 1
)
echo ✅ Root dependencies installed

{{#unless (eq template "api-only")}}
REM Install web app dependencies
echo 🚀 Installing web app dependencies...
if exist "apps\web\package.json" (
    cd apps\web
    %PACKAGE_MANAGER% install
    if errorlevel 1 (
        echo ❌ Failed to install web app dependencies
        pause
        exit /b 1
    )
    cd ..\..
    echo ✅ Web app dependencies installed
) else (
    echo ⚠️ apps\web\package.json not found, skipping web dependencies
)
{{/unless}}

REM Create .env file if it doesn't exist
if not exist ".env" (
    echo 🚀 Creating .env file...
    (
        echo # Environment variables for {{project_name}}
        echo # Copy this file to .env.local and customize as needed
        echo.
        echo # API Configuration
        echo API_HOST=localhost
        echo API_PORT=8000
        echo API_URL=http://localhost:8000
        echo.
        echo # Database Configuration
        {{#if (eq database "mongodb")}}
    echo MONGODB_URL=mongodb://farm:development@localhost:27017/{{project_name}}?authSource=admin
        {{else if (eq database "postgresql")}}
        echo DATABASE_URL=postgresql://localhost:5432/{{project_name}}
        {{else if (eq database "mysql")}}
        echo DATABASE_URL=mysql://localhost:3306/{{project_name}}
        {{else if (eq database "sqlite")}}
        echo DATABASE_URL=sqlite:///./{{project_name}}.db
        {{/if}}
        echo.
        echo # AI Configuration
        {{#if_feature "ai"}}
        echo # Local AI ^(Ollama^)
        echo OLLAMA_BASE_URL=http://localhost:11434
        echo OLLAMA_MODEL=llama3.2
        echo.
        echo # Cloud AI ^(OpenAI^)
        echo OPENAI_API_KEY=your_openai_api_key_here
        {{/if_feature}}
        echo.
        echo # Development
        echo NODE_ENV=development
        echo DEBUG=true
    ) > .env
    echo ✅ .env file created
)

echo ✅ Setup complete! 🎉
echo.
echo Next steps:
echo 1. Copy .env to .env.local and customize your environment variables
{{#if_feature "ai"}}
echo 2. Start Ollama: docker-compose up -d ollama
{{/if_feature}}
echo 3. Start development: %PACKAGE_MANAGER% run dev
echo.
echo Happy coding! 🚀
pause
