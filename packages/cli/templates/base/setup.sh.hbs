#!/bin/bash
# Auto-generated setup script for {{project_name}}
# Generated by FARM Framework CLI

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}🚀${NC} $1"
}

print_success() {
    echo -e "${GREEN}✅${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠️${NC} $1"
}

print_error() {
    echo -e "${RED}❌${NC} $1"
}

# Check if we're in the right directory
if [ ! -f "package.json" ]; then
    print_error "package.json not found. Please run this script from the project root directory."
    exit 1
fi

print_status "Setting up {{project_name}}..."

# Check prerequisites
print_status "Checking prerequisites..."

# Check Node.js
if ! command -v node &> /dev/null; then
    print_error "Node.js is not installed. Please install Node.js 18+ and try again."
    exit 1
fi

# Check Python
if ! command -v python3 &> /dev/null && ! command -v python &> /dev/null; then
    print_error "Python is not installed. Please install Python 3.11+ and try again."
    exit 1
fi

# Use python3 if available, otherwise python
PYTHON_CMD="python3"
if ! command -v python3 &> /dev/null; then
    PYTHON_CMD="python"
fi

print_success "Prerequisites check passed"

# Create Python virtual environment
print_status "Creating Python virtual environment..."
if [ -d "venv" ]; then
    print_warning "Virtual environment already exists. Removing old one..."
    rm -rf venv
fi

$PYTHON_CMD -m venv venv
print_success "Virtual environment created"

# Activate venv and install Python dependencies
print_status "Installing Python dependencies..."
source venv/bin/activate

# Upgrade pip first
venv/bin/python -m pip install --upgrade pip

# Install requirements
if [ -f "apps/api/requirements.txt" ]; then
    venv/bin/python -m pip install -r apps/api/requirements.txt
    print_success "Python dependencies installed"
else
    print_warning "apps/api/requirements.txt not found, skipping Python dependencies"
fi

# Deactivate venv
deactivate

# Check for package manager
print_status "Checking package manager..."
if command -v pnpm &> /dev/null; then
    PACKAGE_MANAGER="pnpm"
    print_success "Using pnpm"
elif command -v yarn &> /dev/null; then
    PACKAGE_MANAGER="yarn"
    print_success "Using yarn"
else
    PACKAGE_MANAGER="npm"
    print_success "Using npm"
fi

# Install Node.js dependencies
print_status "Installing Node.js dependencies..."
$PACKAGE_MANAGER install
print_success "Root dependencies installed"

{{#unless (eq template "api-only")}}
# Install web app dependencies
print_status "Installing web app dependencies..."
if [ -f "apps/web/package.json" ]; then
    cd apps/web
    $PACKAGE_MANAGER install
    cd ../..
    print_success "Web app dependencies installed"
else
    print_warning "apps/web/package.json not found, skipping web dependencies"
fi
{{/unless}}

# Create .env file if it doesn't exist
if [ ! -f ".env" ]; then
    print_status "Creating .env file..."
    cat > .env << EOF
# Environment variables for {{project_name}}
# Copy this file to .env.local and customize as needed

# API Configuration
API_HOST=localhost
API_PORT=8000
API_URL=http://localhost:8000

# Database Configuration
{{#if (eq database "mongodb")}}
MONGODB_URL=mongodb://farm:development@localhost:27017/{{project_name}}?authSource=admin
{{else if (eq database "postgresql")}}
DATABASE_URL=postgresql://localhost:5432/{{project_name}}
{{else if (eq database "mysql")}}
DATABASE_URL=mysql://localhost:3306/{{project_name}}
{{else if (eq database "sqlite")}}
DATABASE_URL=sqlite:///./{{project_name}}.db
{{/if}}

# AI Configuration
{{#if_feature "ai"}}
# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
{{/if_feature}}

# Development
NODE_ENV=development
DEBUG=true
EOF
    print_success ".env file created"
fi

print_success "Setup complete! 🎉"
echo ""
echo "Next steps:"
echo "1. Copy .env to .env.local and customize your environment variables"
{{#if_feature "ai"}}
echo "2. Start Ollama: docker-compose up -d ollama"
{{/if_feature}}
echo "3. Start development: $PACKAGE_MANAGER run dev"
echo ""
echo "Happy coding! 🚀"
