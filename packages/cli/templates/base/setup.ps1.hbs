# Auto-generated setup script for {{project_name}}
# Generated by FARM Framework CLI

param(
    [switch]$SkipPrerequisites,
    [switch]$SkipPython,
    [switch]$SkipNode,
    [switch]$Verbose
)

# Set error action preference
$ErrorActionPreference = "Stop"

# Colors for output
$Colors = @{
    Red = "Red"
    Green = "Green"
    Yellow = "Yellow"
    Blue = "Cyan"
    White = "White"
}

function Write-Status {
    param([string]$Message)
    Write-Host "🚀 $Message" -ForegroundColor $Colors.Blue
}

function Write-Success {
    param([string]$Message)
    Write-Host "✅ $Message" -ForegroundColor $Colors.Green
}

function Write-Warning {
    param([string]$Message)
    Write-Host "⚠️ $Message" -ForegroundColor $Colors.Yellow
}

function Write-Error {
    param([string]$Message)
    Write-Host "❌ $Message" -ForegroundColor $Colors.Red
}

# Check if we're in the right directory
if (-not (Test-Path "package.json")) {
    Write-Error "package.json not found. Please run this script from the project root directory."
    exit 1
}

Write-Status "Setting up {{project_name}}..."

# Check prerequisites
if (-not $SkipPrerequisites) {
    Write-Status "Checking prerequisites..."

    # Check Node.js
    try {
        $nodeVersion = node --version 2>$null
        if ($Verbose) { Write-Host "Node.js version: $nodeVersion" -ForegroundColor $Colors.White }
    }
    catch {
        Write-Error "Node.js is not installed. Please install Node.js 18+ and try again."
        exit 1
    }

    # Check Python
    try {
        $pythonVersion = python --version 2>$null
        if ($Verbose) { Write-Host "Python version: $pythonVersion" -ForegroundColor $Colors.White }
    }
    catch {
        Write-Error "Python is not installed. Please install Python 3.11+ and try again."
        exit 1
    }

    Write-Success "Prerequisites check passed"
}

# Create Python virtual environment
if (-not $SkipPython) {
    Write-Status "Creating Python virtual environment..."
    
    if (Test-Path "venv") {
        Write-Warning "Virtual environment already exists. Removing old one..."
        Remove-Item -Recurse -Force "venv"
    }

    python -m venv venv
    Write-Success "Virtual environment created"

    # Activate venv and install Python dependencies
    Write-Status "Installing Python dependencies..."
    
    # Activate virtual environment
    & "venv\Scripts\Activate.ps1"
    
    # Upgrade pip first
    python -m pip install --upgrade pip

    # Install requirements
    if (Test-Path "apps\api\requirements.txt") {
        python -m pip install -r apps\api\requirements.txt
        Write-Success "Python dependencies installed"
    }
    else {
        Write-Warning "apps\api\requirements.txt not found, skipping Python dependencies"
    }

    # Deactivate virtual environment
    deactivate
}

# Check for package manager
if (-not $SkipNode) {
    Write-Status "Checking package manager..."
    
    $packageManager = "npm"
    try {
        $pnpmVersion = pnpm --version 2>$null
        $packageManager = "pnpm"
        Write-Success "Using pnpm"
        if ($Verbose) { Write-Host "pnpm version: $pnpmVersion" -ForegroundColor $Colors.White }
    }
    catch {
        try {
            $yarnVersion = yarn --version 2>$null
            $packageManager = "yarn"
            Write-Success "Using yarn"
            if ($Verbose) { Write-Host "yarn version: $yarnVersion" -ForegroundColor $Colors.White }
        }
        catch {
            Write-Success "Using npm"
        }
    }

    # Install Node.js dependencies
    Write-Status "Installing Node.js dependencies..."
    & $packageManager install
    Write-Success "Root dependencies installed"

    {{#unless (eq template "api-only")}}
    # Install web app dependencies
    Write-Status "Installing web app dependencies..."
    if (Test-Path "apps\web\package.json") {
        Push-Location "apps\web"
        & $packageManager install
        Pop-Location
        Write-Success "Web app dependencies installed"
    }
    else {
        Write-Warning "apps\web\package.json not found, skipping web dependencies"
    }
    {{/unless}}
}

# Create .env file if it doesn't exist
if (-not (Test-Path ".env")) {
    Write-Status "Creating .env file..."
    
    $envContent = @"
# Environment variables for {{project_name}}
# Copy this file to .env.local and customize as needed

# API Configuration
API_HOST=localhost
API_PORT=8000
API_URL=http://localhost:8000

# Database Configuration
{{#if (eq database "mongodb")}}
MONGODB_URL=mongodb://farm:development@localhost:27017/{{project_name}}?authSource=admin
{{else if (eq database "postgresql")}}
DATABASE_URL=postgresql://localhost:5432/{{project_name}}
{{else if (eq database "mysql")}}
DATABASE_URL=mysql://localhost:3306/{{project_name}}
{{else if (eq database "sqlite")}}
DATABASE_URL=sqlite:///./{{project_name}}.db
{{/if}}

# AI Configuration
{{#if_feature "ai"}}
# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud AI (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
{{/if_feature}}

# Development
NODE_ENV=development
DEBUG=true
"@
    
    $envContent | Out-File -FilePath ".env" -Encoding UTF8
    Write-Success ".env file created"
}

Write-Success "Setup complete! 🎉"
Write-Host ""
Write-Host "Next steps:" -ForegroundColor $Colors.White
Write-Host "1. Copy .env to .env.local and customize your environment variables" -ForegroundColor $Colors.White
{{#if_feature "ai"}}
Write-Host "2. Start Ollama: docker-compose up -d ollama" -ForegroundColor $Colors.White
{{/if_feature}}
Write-Host "3. Start development: $packageManager run dev" -ForegroundColor $Colors.White
Write-Host ""
Write-Host "Happy coding! 🚀" -ForegroundColor $Colors.Green
