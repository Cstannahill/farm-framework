# Environment Variables Configuration
# Copy this file to .env and update with your actual values

# Application Configuration
APP_NAME={{projectName}}
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (MongoDB)
# Standardized development MongoDB credentials (must match docker-compose.yml)
DATABASE_URL=mongodb://farm:development@localhost:27017/{{kebabCase projectName}}?authSource=admin

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4200
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# AI Configuration
AI_DEFAULT_PROVIDER=ollama
AI_OLLAMA_URL=http://localhost:11434
AI_DEFAULT_MODEL=llama3.1
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TOP_P=0.9

# Optional AI Provider API Keys (uncomment and add your keys)
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# HUGGINGFACE_API_KEY=hf_your-huggingface-key-here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
