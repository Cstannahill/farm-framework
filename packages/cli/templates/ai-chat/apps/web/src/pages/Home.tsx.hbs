              <Button variant="outline" className="px-5">View on GitHub</Button>
            </a>
          </div>
          <div className="container z-50 my-3">
            <Card className="order-2 md:order-1 mx-15">
              <CardHeader>
                <CardTitle>API Status</CardTitle>
                <CardDescription>
                  {isLoading ? (
                    <span className="text-muted-foreground">Checking...</span>
                  ) : health ? (
                    <span className="text-green-500">✅ API is {health.status}</span>
                  ) : (
                    <span className="text-red-500">❌ API unavailable</span>
                  )}
                </CardDescription>
              </CardHeader>
            </Card>
          </div>
