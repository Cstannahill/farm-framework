# packages/cli/templates/base/apps/api/pyproject.toml.hbs
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{projectName}}-api"
version = "0.1.0"
description = "FastAPI backend for {{projectName}}"
readme = "README.md"
requires-python = ">=3.11"
authors = [
    {name = "{{author.name}}", email = "{{author.email}}"},
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Framework :: FastAPI",
]
dependencies = [
    # FastAPI and ASGI server
    "fastapi==0.116.1",
    "uvicorn[standard]==0.35.0",
    
    # Database dependencies
    {{#switch database}}
    {{#case "mongodb"}}
    # MongoDB
    "motor==3.7.1",
    "beanie==2.0.0",
    "pymongo==4.14.1",
    {{/case}}
    {{#case "postgresql"}}
    # PostgreSQL
    "asyncpg==0.30.0",
    "sqlalchemy[asyncio]==2.0.36",
    "alembic==1.15.0",
    {{/case}}
    {{#case "mysql"}}
    # MySQL
    "aiomysql==0.3.0",
    "sqlalchemy[asyncio]==2.0.36",
    "alembic==1.15.0",
    {{/case}}
    {{#case "sqlite"}}
    # SQLite
    "aiosqlite==0.22.0",
    "sqlalchemy[asyncio]==2.0.36",
    "alembic==1.15.0",
    {{/case}}
    {{#case "sqlserver"}}
    # SQL Server
    "aioodbc==0.5.0",
    "pyodbc==5.2.0",
    "sqlalchemy[asyncio]==2.0.36",
    "alembic==1.15.0",
    {{/case}}
    {{/switch}}
    
    {{#if_feature "auth"}}
    # Authentication and security
    "python-jose[cryptography]==3.5.0",
    "passlib[bcrypt]==1.7.4",
    "python-multipart==0.0.2",
    {{/if_feature}}
    
    {{#if_feature "ai"}}
    # HTTP client for AI providers
    "httpx==0.28.1",
    
    {{#if_template "ai-chat" "ai-dashboard"}}
    {{#if ai.providers.openai.enabled}}
    # OpenAI
    "openai==1.107.0",
    {{/if}}
    
    {{#if ai.providers.anthropic.enabled}}
    # Anthropic
    "anthropic==0.40.0",
    {{/if}}
    
    {{#if ai.providers.huggingface.enabled}}
    # Hugging Face
    "transformers==5.1.0",
    "torch==2.6.0",
    {{/if}}
    {{else}}
    # Basic AI support
    "openai==1.107.0",
    {{/if_template}}
    {{/if_feature}}
    
    {{#if_feature "realtime"}}
    # WebSocket support
    "websockets==13.1",
    {{/if_feature}}
    
    {{#if_feature "storage"}}
    # Storage providers
    {{#switch storage.type}}
    {{#case "s3"}}
    "boto3==1.36.51",
    {{/case}}
    {{#case "gcs"}}
    "google-cloud-storage==2.19.0",
    {{/case}}
    {{#case "azure"}}
    "azure-storage-blob==13.0.0",
    {{/case}}
    {{/switch}}
    {{/if_feature}}
    
    {{#if_feature "email"}}
    # Email support
    "aiosmtplib==3.0.2",
    "jinja2==3.1.4",
    {{/if_feature}}
    
    {{#if_feature "analytics"}}
    # Analytics
    "mixpanel==5.0.0",
    {{/if_feature}}
    
    {{#if_feature "search"}}
    # Search functionality
    "elasticsearch[async]==8.16.0",
    {{/if_feature}}
    
    # Configuration management
    "pydantic[email]==2.11.7",
    "pydantic-settings==2.10.0",
    
    # Logging and monitoring
    "python-json-logger==3.3.0",
    "coloredlogs==15.0.1",
    
    {{#if_feature "observability"}}
    # Observability
    "prometheus-client==0.22.0",
    "opentelemetry-api==1.30.0",
    "opentelemetry-sdk==1.30.0",
    "opentelemetry-instrumentation-fastapi==0.51b0",
    {{/if_feature}}
    
    # Environment management
    "python-dotenv==1.0.1",
]

[project.optional-dependencies]
dev = [
    # Development and testing dependencies
    "pytest==8.4.0",
    "pytest-asyncio==1.0.0",
    "pytest-cov==6.0.0",
    "httpx==0.28.1",  # For testing
    "faker==33.1.0",  # For test data generation
    
    # Code quality
    "black==24.10.0",
    "isort==5.13.2",
    "flake8==7.1.1",
    "mypy==1.14.0",
]

docs = [
    # Documentation
    "mkdocs==1.6.1",
    "mkdocs-material==9.6.19",
]

[project.urls]
Homepage = "https://github.com/{{author.github}}/{{projectName}}"
Documentation = "https://{{projectName}}.readthedocs.io"
Repository = "https://github.com/{{author.github}}/{{projectName}}.git"
"Bug Tracker" = "https://github.com/{{author.github}}/{{projectName}}/issues"

[project.scripts]
{{projectName}}-api = "src.main:app"

[tool.hatch.build.targets.wheel]
packages = ["src"]

[tool.black]
line-length = 88
target-version = ['py311']
include = '\.pyi?$'
extend-exclude = '''
/(
  # directories
  \.eggs
  | \.git
  | \.hg
  | \.mypy_cache
  | \.tox
  | \.venv
  | build
  | dist
)/
'''

[tool.isort]
profile = "black"
multi_line_output = 3
line_length = 88
known_first_party = ["src"]

[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
disallow_untyped_decorators = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true
strict_equality = true

[[tool.mypy.overrides]]
module = [
    "motor.*",
    "beanie.*",
    "pymongo.*",
    "asyncpg.*",
    "aiomysql.*",
    "aiosqlite.*",
    "aioodbc.*",
    "pyodbc.*",
    "elasticsearch.*",
    "boto3.*",
    "google.cloud.*",
    "azure.*",
    "mixpanel.*",
    "transformers.*",
    "torch.*",
    "opentelemetry.*",
]
ignore_missing_imports = true

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py", "*_test.py"]
python_classes = ["Test*"]
python_functions = ["test_*"]
addopts = [
    "--strict-markers",
    "--strict-config",
    "--cov=src",
    "--cov-report=term-missing",
    "--cov-report=html",
    "--cov-report=xml",
]
markers = [
    "slow: marks tests as slow (deselect with '-m \"not slow\"')",
    "integration: marks tests as integration tests",
    "unit: marks tests as unit tests",
]

[tool.coverage.run]
source = ["src"]
omit = [
    "*/tests/*",
    "*/test_*",
    "*/__pycache__/*",
    "*/migrations/*",
]

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "if self.debug:",
    "if settings.DEBUG",
    "raise AssertionError",
    "raise NotImplementedError",
    "if 0:",
    "if __name__ == .__main__.:",
    "class .*\\bProtocol\\):",
    "@(abc\\.)?abstractmethod",
]
