# Health check functions
async def check_database_health() -> bool:
    """Check if database is healthy"""
    try:
        {{#switch database}}
        {{#case "mongodb"}}
        if not _mongo_client:
            return False
        
        await _mongo_client.admin.command('ping')
        return True
        {{/case}}
        {{#case "postgresql" "mysql" "sqlite" "sqlserver"}}
        if not _engine:
            return False
        
        async with _engine.begin() as conn:
            await conn.execute(text("SELECT 1"))
        return True
        {{/case}}
        {{/switch}}
    except Exception as e:
        logger.error(f"Database health check failed: {str(e)}")
        return False

async def get_database_info() -> dict:
    """Get database information"""
    try:
        {{#switch database}}
        {{#case "mongodb"}}
        if not _mongo_client:
            return {"status": "disconnected", "type": "mongodb"}
        
        # Get server info
        server_info = await _mongo_client.server_info()
        return {
            "status": "connected",
            "type": "mongodb",
            "version": server_info.get("version"),
            "database": _database.name if _database else "unknown"
        }
        {{/case}}
        {{#case "postgresql" "mysql" "sqlite" "sqlserver"}}
        if not _engine:
            return {"status": "disconnected", "type": "{{database}}"}
        
        async with _engine.begin() as conn:
            {{#if_database "postgresql"}}
            result = await conn.execute(text("SELECT version()"))
            version = result.scalar()
            {{/if_database}}
            {{#if_database "mysql"}}
            result = await conn.execute(text("SELECT VERSION()"))
            version = result.scalar()
            {{/if_database}}
            {{#if_database "sqlite"}}
            result = await conn.execute(text("SELECT sqlite_version()"))
            version = result.scalar()
            {{/if_database}}
            {{#if_database "sqlserver"}}
            result = await conn.execute(text("SELECT @@VERSION"))
            version = result.scalar()
            {{/if_database}}
        
        return {
            "status": "connected",
            "type": "{{database}}",
            "version": version
        }
        {{/case}}
        {{/switch}}
    except Exception as e:
        logger.error(f"Failed to get database info: {str(e)}")
        return {"status": "error", "type": "{{database}}", "error": str(e)}
