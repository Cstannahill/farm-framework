{
  "name": "@farm-framework/code-intelligence",
  "version": "0.1.0",
  "description": "Code intelligence, vector search, and AI-powered explanations for FARM framework",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/ts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ts/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "build:bundle": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node dist/test/test-vector-db.js"
  },
  "keywords": [
    "code-intelligence",
    "vector-search",
    "semantic-search",
    "ai",
    "embeddings",
    "code-explanation",
    "farm",
    "typescript",
    "ast"
  ],
  "author": "FARM Framework Team",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md"
  ],
  "dependencies": {
    "@farm-framework/types": "workspace:*",
    "@farm-framework/core": "workspace:*",
    "@farm-framework/observability": "workspace:*",
    "chromadb": "^1.8.1",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "node-fetch": "^3.3.2",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "chokidar": "^3.5.3",
    "typescript": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}