{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "cache": true
    },
    "build:ts": {
      "dependsOn": [
        "^build:ts"
      ],
      "outputs": [
        "dist/ts/**",
        "tsconfig.tsbuildinfo"
      ],
      "cache": true
    },
    "build:bundle": {
      "dependsOn": [
        "^build:ts",
        "^build:bundle"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "turbo.json"
  ]
}